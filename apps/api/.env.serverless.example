# Copy these names into the Vercel API project's Environment Variables.
# Never commit real values. Use the pooled DATABASE_URL at request time and
# DIRECT_DATABASE_URL only for the one-off migration command.

DJANGO_SETTINGS_MODULE=plane.settings.serverless
SERVERLESS_MODE=1
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=api.example.com

# Include every deployed browser origin, comma-separated. Do not use * with
# credentialed cookies in production.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com,https://spaces.example.com

# Neon/Supabase. Use the provider's pooled URL here.
DATABASE_URL=postgresql://user:password@host-pooler.example/neondb?sslmode=require
# Used only by apps/api/bin/migrate-serverless.sh, never by browser code.
DIRECT_DATABASE_URL=postgresql://user:password@host.example/neondb?sslmode=require
DATABASE_CONN_MAX_AGE=0

# Upstash Redis connection string. rediss:// is expected for hosted Redis.
REDIS_URL=rediss://default:password@host.upstash.io:6379
SERVERLESS_INLINE_TASKS=1

# Cloudflare R2 (S3-compatible object storage).
USE_MINIO=0
AWS_REGION=auto
AWS_ACCESS_KEY_ID=replace-with-r2-access-key
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret
AWS_S3_BUCKET_NAME=plane-uploads
AWS_S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

# Public URLs. Keep the API URL free of a trailing /api path; the application
# appends /api, /auth, and /api/public itself.
WEB_URL=https://app.example.com
APP_BASE_URL=https://app.example.com
APP_BASE_PATH=/
ADMIN_BASE_URL=https://admin.example.com
ADMIN_BASE_PATH=/
SPACE_BASE_URL=https://spaces.example.com
SPACE_BASE_PATH=/
LIVE_BASE_URL=https://live.example.com
LIVE_BASE_PATH=/live
COOKIE_DOMAIN=

# Transactional SMTP. Resend's SMTP relay is a convenient free-tier option.
ENABLE_SMTP=1
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_replace_me
EMAIL_FROM=Plane <noreply@example.com>
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Optional OAuth/integrations. Add the provider-specific values used by the
# instance before enabling those login methods.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
